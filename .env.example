# Copy to .env for local/Docker/PaaS use. Never commit .env with real values.
# The Flask app itself only needs HOST/PORT/FLASK_DEBUG.
# The on-chain bridge reads config_chain.py (see tools/config_chain.example.py),
# not these env vars, but they are documented here for deployment platforms.

# ── Flask ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# ── On-chain bridge (optional, Polygon Amoy testnet) ─────────────────────
# These mirror tools/config_chain.example.py for platforms that prefer env vars.
# POLY_AMOY_RPC=https://rpc-amoy.polygon.technology
# CONTRACT_ADDRESS=0x7fc71404Ce10f84B5C467AB3c9806507D422fEf4
# PRIVATE_KEY=your-testnet-private-key-here
# CHAIN_ID=80002

# ── Web search (optional) ─────────────────────────────────────────────────
# WEB_SEARCH_TIMEOUT=45